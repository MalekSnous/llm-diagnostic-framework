# LLM Diagnostic Framework - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# LLM API Keys
# ============================================

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (open-weight models via OpenAI-compatible API; select with model="groq/<id>",
# e.g. groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant, groq/openai/gpt-oss-120b)
GROQ_API_KEY=gsk_...

HUGGINGFACE_TOKEN=hf_your_token_here



# ============================================
# Optional: Other LLM Providers
# ============================================

# Cohere
COHERE_API_KEY=

# Together AI (for open-source models)
TOGETHER_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# ============================================
# Vector Database (for RAG)
# ============================================

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Weaviate
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ============================================
# Observability & Logging
# ============================================

# LangSmith (LangChain tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=llm-diagnostic

# Weights & Biases (experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=llm-diagnostic
WANDB_ENTITY=

# ============================================
# Configuration
# ============================================

# Default LLM model
#DEFAULT_LLM_MODEL=gpt-4-turbo-preview
DEFAULT_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0



# Max tokens for LLM responses
MAX_TOKENS=2000

# Temperature for LLM
TEMPERATURE=0.0

# Results directory
RESULTS_DIR=./results

# Cache directory
CACHE_DIR=./.cache

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Deployment (Optional)
# ============================================

# Modal token (for Modal deployment)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# AWS (for SageMaker deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================
# Development
# ============================================

# Enable debug mode
DEBUG=false

# Random seed for reproducibility
RANDOM_SEED=42